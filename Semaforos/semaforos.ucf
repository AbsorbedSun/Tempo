# Reloj de 100 MHz
NET "clk" LOC = V10;
NET "clk" TNM_NET = clk_pin;
TIMESPEC TS_clk_pin = PERIOD clk_pin 100 MHz HIGH 50%;
# Switches
NET "run"   LOC = T10;  # SW0
NET "reset" LOC = T5 ;  # SW7
# LEDs semaforo 1
NET "r1" LOC = U16;  # LD0 rojo
NET "a1" LOC = V16;  # LD1 amarillo
NET "v1" LOC = U15;  # LD2 verde
# LEDs semaforo 2
NET "r2" LOC = V15;  # LD3 rojo
NET "a2" LOC = M11;  # LD4 amarillo
NET "v2" LOC = N11;  # LD5 verde
